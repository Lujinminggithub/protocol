{
  // log4c.json - Configuration for the log4c logging library
  // Place this file in the same directory as your executable.

  /* Log directory path (default: {exe_dir}/logs) */
  "log_dir": "",

  /* Custom log filename (default: {process_name}.log) */
  /* Set to empty string to use the default pattern */
  "log_filename": "",

  /* Initial log level: "DEBUG", "INFO", "WARN", or "ERROR" */
  "initial_level": "DEBUG",

  /* Rotate log file when it reaches this size in megabytes (default: 10) */
  "rotate_size_mb": 10,

  /* Delete oldest rotated files when total size exceeds this in megabytes (default: 500) */
  "cleanup_size_mb": 500,

  /* Run cleanup check every N log writes (default: 10) */
  "cleanup_every_n": 10,

  /* Poll interval for hot-reload in milliseconds (default: 1000) */
  "hot_reload_interval_ms": 1000,

  /* Filename for the hot-reload level config (default: "level.txt") */
  "level_file_name": "level.txt",

  /* Include [file:line func] in DEBUG log lines (default: true) */
  "include_source_info": true,

  /* Timestamp format string (default: "%Y-%m-%d %H:%M:%S.%03d") */
  "timestamp_format": "%Y-%m-%d %H:%M:%S.%03d"
}
