; PersonalSafer file system minifilter installation

[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {B86DFF51-A31E-4BAC-B3CF-E8CFE75C9FC2}
Provider    = %ManufacturerName%
CatalogFile =
DriverVer = 07/24/2026,14.31.12.480
PnpLockdown = 1

[DestinationDirs]
PersonalSafer.DriverFiles = 13

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDesc%
CopyFiles  = PersonalSafer.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,PersonalSafer.Service

[PersonalSafer.Service]
DisplayName     = %ServiceName%
Description     = %ServiceDesc%
ServiceBinary   = %13%\PersonalSafer.sys
ServiceType     = 2
StartType       = 3
ErrorControl    = 1
LoadOrderGroup  = "FSFilter Activity Monitor"
Dependencies    = FltMgr
AddReg          = PersonalSafer.AddRegistry

[PersonalSafer.AddRegistry]
HKR,"Parameters","SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%InstanceName%
HKR,"Parameters\Instances\%InstanceName%","Altitude",0x00000000,%InstanceAltitude%
HKR,"Parameters\Instances\%InstanceName%","Flags",0x00010001,0
HKR,"Instances","DefaultInstance",0x00000000,%InstanceName%
HKR,"Instances\%InstanceName%","Altitude",0x00000000,%InstanceAltitude%
HKR,"Instances\%InstanceName%","Flags",0x00010001,0

[PersonalSafer.DriverFiles]
PersonalSafer.sys

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
PersonalSafer.sys = 1

[Strings]
ManufacturerName = "PersonalSafer Team"
ServiceName      = "PersonalSafer"
ServiceDesc      = "PersonalSafer Security Minifilter"
InstanceName     = "PersonalSafer Instance"
InstanceAltitude = "379950"
DiskName         = "PersonalSafer Driver Installation Disk"

