NB_CONTROL_LISTEN=127.0.0.1:9080
NB_CONTROL_STATE_DIR=/var/lib/nb-control
NB_CONTROL_USERS_FILE=/etc/NB/users.conf
NB_CONTROL_TENANTS_FILE=/etc/NB/tenants.conf
NB_CONTROL_SOCKET_GLOB=/run/nb-entry-*.ctl
NB_LINE_ID=replace-with-deployment-id
NB_WEB_BASE_URL=https://web.example.invalid
# Inject all secrets from the deployment secret store; never commit values.
NB_CONTROL_API_TOKEN=
NB_WEB_TOKEN=
NB_WEB_SIGNING_KEY=
