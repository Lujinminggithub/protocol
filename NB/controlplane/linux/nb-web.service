[Unit]
Description=NB central operations web console
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/opt/nb-controlplane/etc/nb-web.env
EnvironmentFile=/opt/nb-controlplane/etc/nb-web-mysql.env
Environment=NB_WEB_DEVICE_SECRETS_FILE=/opt/nb-controlplane/data/secrets/device-secrets.json
ExecStart=/opt/nb-controlplane/bin/nb-web
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/nb-controlplane/data/web /opt/nb-controlplane/data/secrets

[Install]
WantedBy=multi-user.target
