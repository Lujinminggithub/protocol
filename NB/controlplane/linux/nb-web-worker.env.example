NB_WEB_BASE_URL=http://127.0.0.1:19091
NB_WEB_AGENT_TOKEN=replace-with-private-agent-token
NB_WEB_WORKER_REGISTRY=/opt/nb-controlplane/etc/worker-registry.json
NB_WEB_WORKER_POLL_SECONDS=2
NB_WEB_WORKER_HEARTBEAT_SECONDS=10
NB_WEB_WORKER_SNAPSHOT_SECONDS=15
NB_WEB_WORKER_MAINTENANCE_SECONDS=300
NB_WEB_WORKER_OPERATION_TIMEOUT_SECONDS=2700
# Keep signed whitelist URLs out of Git. The worker accepts either the
# MD5|URL metadata endpoint or the direct SRS endpoint in this variable.
NB_LINE_SRS_URL=https://replace-with-private-whitelist-source
